# HeatShield AI - Environment Configuration Example

# Server Configuration
PORT=8000
HOST=0.0.0.0

# AI Provider API Keys (Optional)
# If no API key is provided, HeatShield AI automatically operates using its
# built-in, zero-dependency Grounded Expert Rule-Based Engine with zero errors!
GEMINI_API_KEY=
OPENAI_API_KEY=

# Weather API (Open-Meteo is free and requires NO key by default)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Map Provider (Leaflet & OpenStreetMap are free and require NO key by default)
# MAPBOX_ACCESS_TOKEN=
